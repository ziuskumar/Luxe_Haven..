      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navbar Collapse Content -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      
      <!-- Centered Search Pill -->
      <div class="navbar-search-container mx-auto">
        <form class="search-pill-form" role="search" action="/listings" method="GET">
          <div class="search-pill-wrapper">
            <input
              class="search-pill-input"
              type="search"
              name="q"
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
              placeholder="Search destinations..."
              aria-label="Search"
            />
            <button class="search-pill-btn" type="submit">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>
        </form>
      </div>

      <!-- Right Actions (Host and User Menu) -->
      <div class="navbar-nav align-items-center gap-2 gap-md-3">
        <a class="nav-link host-link fw-bold px-3 py-2 rounded-pill d-none d-md-inline-block" href="/listings/new">
          Host your home
        </a>
        
        <!-- User Dropdown Pill Menu -->
        <div class="dropdown user-dropdown">
          <button

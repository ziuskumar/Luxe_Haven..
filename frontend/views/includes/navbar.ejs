              <li>
                <a class="dropdown-item py-2 text-dark" href="/signup">
                  <i class="fa-solid fa-user-plus me-2" style="color: #0d9488;"></i>Sign Up
                </a>
              </li>
              <li>
                <a class="dropdown-item py-2 text-primary fw-bold" href="/login">
                  <i class="fa-solid fa-right-to-bracket me-2" style="color: #6366f1;"></i>Login

              <span class="avatar text-white d-flex align-items-center justify-content-center fw-bold text-uppercase">
                <%= currentUser.username[0] %>
              </span>
            <% } else { %>
              <i class="fa-solid fa-circle-user avatar-placeholder" style="color: #ff385c;"></i>
            <% } %>
          </button>
          
          <ul class="dropdown-menu dropdown-menu-end shadow mt-2 border-0 py-2 rounded-4" aria-labelledby="profileDropdown">
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <li>
                <span class="dropdown-item-text fw-bold border-bottom pb-2 mb-2 d-block">

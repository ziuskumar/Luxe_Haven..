<nav class="navbar navbar-expand-md navbar-light sticky-top">
  <div class="container-fluid px-md-5">
    <!-- Brand Logo -->
    <a class="navbar-brand fw-bold" href="/listings">
      <i class="fa-solid fa-compass me-2" style="color: #ff385c;"></i><span class="logo-luxe">Luxe</span><span class="logo-haven">Haven</span>
    </a>

    <!-- Mobile Toggler -->
    <button
